.sub{
  font-size:12px;
  color:var(--muted);
  margin-top:8px;
  line-height:1.4;
  overflow-wrap:break-word;
}

.meter{
  margin-top:12px;
  height:10px;
  width:100%;
  border-radius:999px;
  background:#081126;
  border:1px solid var(--line);
  overflow:hidden;
}

.meter > span{
  display:block;
  height:100%;
  width:0%;
  transition:width .35s ease;
}

.meter-capacity > span{
  background:linear-gradient(90deg,#67c1ff,#a1d8ff,#d8b84c);
}

.meter-strain > span{
  background:linear-gradient(90deg,#67d26f,#d8b84c,#ff6666);
}

.stateBadge{
  display:inline-block;
  margin-top:12px;
  padding:6px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:700;
  background:rgba(103,193,255,.10);
  color:var(--blue);
  border:1px solid rgba(103,193,255,.18);
}

.midRow{
  display:grid;
  grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);
  gap:14px;
  margin-bottom:14px;
  min-width:0;
}

.microCard{
  background:rgba(255,255,255,.025);
  border:1px solid var(--line);
  border-radius:16px;
  padding:14px 16px;
  min-height:126px;
  min-width:0;
}

.microHeader{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin-bottom:8px;
  min-width:0;
}

.microTitle{
  font-size:11px;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.08em;
  font-weight:700;
  overflow-wrap:break-word;
}

.verifiedBadge{
  display:inline-flex;
  align-items:center;
  padding:4px 8px;
  border-radius:999px;
  font-size:10px;
  font-weight:700;
  color:var(--teal);
  background:rgba(103,193,255,.08);
  border:1px solid rgba(103,193,255,.14);
  white-space:nowrap;
}

.forecastBig{
  font-size:18px;
  font-weight:800;
  margin:2px 0 6px;
  overflow-wrap:anywhere;
}

.forecastSub{
  font-size:12px;
  color:var(--muted);
  line-height:1.45;
  overflow-wrap:break-word;
}

.whyCard{
  margin-bottom:16px;
  background:rgba(255,255,255,.025);
  border:1px solid var(--line);
  border-radius:16px;
  padding:18px;
  min-width:0;
}

.whyTitle{
  font-size:11px;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.08em;
  font-weight:700;
  margin-bottom:8px;
}

.whyText{
  font-size:13px;
  color:var(--text);
  line-height:1.72;
  overflow-wrap:break-word;
}

.summaryTitle{
  margin:0 0 10px;
  font-size:14px;
  color:var(--text);
  text-transform:uppercase;
  letter-spacing:.08em;
  font-weight:800;
  overflow-wrap:break-word;
}

.table{
  width:100%;
  max-width:100%;
  border-collapse:collapse;
  font-size:13px;
  table-layout:fixed;
}

.table th,
.table td{
  padding:11px 8px;
  border-bottom:1px solid var(--lineSoft);
  text-align:left;
  vertical-align:middle;
  overflow-wrap:anywhere;
}

.table th{
  color:var(--muted);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.badge{
  display:inline-block;
  max-width:100%;
  padding:5px 8px;
  border-radius:999px;
  font-size:11px;
  font-weight:700;
  border:1px solid transparent;
  overflow-wrap:anywhere;
}

.b-blue{background:rgba(103,193,255,.12); color:var(--blue); border-color:rgba(103,193,255,.22)}
.b-red{background:rgba(255,102,102,.12); color:var(--red); border-color:rgba(255,102,102,.22)}
.b-green{background:rgba(103,210,111,.12); color:var(--green); border-color:rgba(103,210,111,.22)}
.b-gold{background:rgba(216,184,76,.12); color:var(--gold); border-color:rgba(216,184,76,.22)}
.b-violet{background:rgba(176,108,255,.08); color:#cab1ff; border-color:rgba(176,108,255,.14)}

.softMetric td{
  opacity:.82;
}

.bottomGrid{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:14px;
  margin-top:14px;
  min-width:0;
}

.miniPanel{
  background:rgba(255,255,255,.025);
  border:1px solid var(--line);
  border-radius:16px;
  padding:16px;
  min-width:0;
  max-width:100%;
  overflow:hidden;
}

.metaRow{
  display:flex;
  gap:8px;
  align-items:center;
  flex-wrap:wrap;
  margin-top:16px;
  min-width:0;
}

.metaPill{
  display:inline-flex;
  align-items:center;
  max-width:100%;
  padding:6px 10px;
  border-radius:999px;
  font-size:11px;
  font-weight:700;
  border:1px solid rgba(255,255,255,.08);
  background:rgba(255,255,255,.03);
  color:var(--muted);
  overflow-wrap:anywhere;
}

.metaPill.field{
  color:#c27cff;
  background:rgba(176,108,255,.10);
  border-color:rgba(176,108,255,.16);
}

.metaPill.forecast{
  color:#6fc0ff;
  background:rgba(103,193,255,.10);
  border-color:rgba(103,193,255,.16);
}

@media (max-width: 1120px){
  .grid{
    grid-template-columns:minmax(0,1fr);
  }

  .inputPanel{
    position:static;
  }

  .heroStats,
  .midRow,
  .bottomGrid,
  .guidanceGrid,
  .profileGrid,
  .regulationSupportGrid,
  .outlookGrid,
  .interactionMapGrid,
  .fieldCompassGrid,
  .liveDebugThreeColumn,
  .plainReadGrid,
  .personalLandingGrid{
    grid-template-columns:minmax(0,1fr);
  }

  .profileBlock.wide,
  .profileBlock.full,
  .regulationSupportBlock.primary,
  .regulationSupportBlock.full,
  .outlookBlock.primary,
  .plainReadBlock.primary,
  .personalLandingBlock.full{
    grid-column:auto;
  }

  .whyReadGrid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .whyMini.full{
    grid-column:1 / -1;
  }

  .libraryGrid,
  .rootLibraryGrid{
    grid-template-columns:minmax(0,1fr);
  }

  .interactionOperator{
    min-height:18px;
  }

  .shareIntro{
    display:grid;
  }

  .shareIntroChips{
    justify-content:flex-start;
    min-width:0;
  }
}

