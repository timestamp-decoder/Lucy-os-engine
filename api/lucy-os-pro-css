:root{
  --bg:#09142f;
  --panel:#0f1b38;
  --panel2:#132347;
  --panel3:#0b1734;
  --line:#2a3c69;
  --lineSoft:rgba(255,255,255,.06);
  --text:#f4f7ff;
  --muted:#aab7d6;
  --muted2:#7f8fb8;
  --blue:#67c1ff;
  --red:#ff6666;
  --green:#67d26f;
  --violet:#b06cff;
  --gold:#d8b84c;
  --teal:#6fe0d3;
  --amber:#f1b84b;
  --rose:#ff9bb7;
  --pearl:#d8edf0;
  --lavender:#cbb7ff;
  --shadow:0 18px 52px rgba(0,0,0,.28);

  --h-structured:#d8b84c;
  --h-contained:#f3fbff;
  --h-chaotic:#67c1ff;
  --h-relational:#ff9bb7;
  --h-threshold:#ff8a3d;
  --h-reconstructive:#b06cff;
  --h-integrative:#a9d7ff;
  --h-diffused:#cbb7ff;
  --h-regulated:#6fe0d3;
  --h-steady:#aab7d6;
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
  width:100%;
  max-width:100%;
  overflow-x:hidden;
}

body{
  margin:0;
  width:100%;
  max-width:100%;
  overflow-x:hidden;
  font-family:Arial, sans-serif;
  background:
    radial-gradient(circle at 50% 0%, rgba(103,193,255,.10), transparent 34%),
    radial-gradient(circle at 80% 12%, rgba(176,108,255,.06), transparent 32%),
    linear-gradient(180deg,#071126 0%, #09142f 100%);
  color:var(--text);
}

img,
svg,
canvas{
  max-width:100%;
}

.wrap{
  width:100%;
  max-width:1380px;
  margin:0 auto;
  padding:18px 24px 24px;
  overflow-x:hidden;
}

.backLink{
  display:inline-flex;
  align-items:center;
  gap:6px;
  width:auto;
  max-width:100%;
  min-height:32px;
  margin:0 0 10px;
  padding:0 12px;
  border-radius:999px;
  border:1px solid rgba(103,193,255,.16);
  background:rgba(103,193,255,.055);
  color:var(--muted);
  font-size:12px;
  font-weight:800;
  text-decoration:none;
  letter-spacing:.02em;
  overflow-wrap:anywhere;
}

.backLink:hover{
  color:var(--blue);
  border-color:rgba(103,193,255,.28);
  background:rgba(103,193,255,.085);
}

.hero{
  position:relative;
  text-align:center;
  width:100%;
  max-width:100%;
  margin-bottom:16px;
  padding:15px 18px 13px;
  overflow:hidden;
  border:1px solid rgba(103,193,255,.13);
  border-radius:20px;
  background:
    radial-gradient(circle at 50% -20%, rgba(103,193,255,.11), transparent 46%),
    linear-gradient(180deg,rgba(15,27,56,.62),rgba(9,20,47,.24));
  box-shadow:0 14px 38px rgba(0,0,0,.22);
}

.heroGlow{
  position:absolute;
  inset:0;
  pointer-events:none;
  opacity:.88;
  transition:background .35s ease;
  background:
    radial-gradient(circle at 50% 28%, rgba(103,193,255,.09), transparent 42%);
}

.hero h1{
  position:relative;
  margin:0;
  font-size:34px;
  letter-spacing:.2px;
  z-index:1;
}

.hero p{
  position:relative;
  margin:6px 0 0;
  color:var(--muted);
  font-size:13px;
  z-index:1;
}

.mobileReadSnapshot{
  display:none;
  width:100%;
  max-width:100%;
  margin:0 0 14px;
  padding:16px;
  border-radius:18px;
  border:1px solid rgba(111,224,211,.20);
  background:
    radial-gradient(circle at 10% 0%, rgba(111,224,211,.10), transparent 34%),
    radial-gradient(circle at 92% 8%, rgba(103,193,255,.075), transparent 34%),
    linear-gradient(180deg,rgba(15,27,56,.96),rgba(12,24,50,.92));
  box-shadow:0 14px 36px rgba(0,0,0,.22);
  overflow:hidden;
}

.mobileSnapshotKicker{
  color:#8bf1e6;
  font-size:10px;
  font-weight:950;
  letter-spacing:.13em;
  text-transform:uppercase;
  margin-bottom:8px;
}

.mobileSnapshotWeather{
  color:var(--text);
  font-size:22px;
  line-height:1.12;
  font-weight:950;
  letter-spacing:-.035em;
  overflow-wrap:anywhere;
}

.mobileSnapshotText{
  margin-top:8px;
  color:#d9e0f4;
  font-size:13px;
  line-height:1.55;
  font-weight:700;
}

.mobileSnapshotGrid{
  display:grid;
  grid-template-columns:minmax(0,1fr);
  gap:8px;
  margin-top:12px;
}

.mobileSnapshotGrid div{
  border:1px solid rgba(255,255,255,.075);
  border-radius:13px;
  padding:10px 11px;
  background:rgba(255,255,255,.035);
}

.mobileSnapshotGrid span{
  display:block;
  color:var(--muted);
  font-size:10px;
  font-weight:950;
  letter-spacing:.10em;
  text-transform:uppercase;
  margin-bottom:5px;
}

.mobileSnapshotGrid strong{
  display:block;
  color:var(--text);
  font-size:13px;
  line-height:1.45;
  font-weight:800;
  overflow-wrap:break-word;
}

.mobileSnapshotMeta{
  margin-top:10px;
  color:var(--muted);
  font-size:11px;
  line-height:1.4;
  font-weight:800;
  overflow-wrap:break-word;
}

.grid{
  display:grid;
  grid-template-columns:360px minmax(0,1fr);
  gap:18px;
  align-items:start;
  width:100%;
  max-width:100%;
  min-width:0;
}

.panel{
  width:100%;
  max-width:100%;
  min-width:0;
  background:linear-gradient(180deg,var(--panel),var(--panel2));
  border:1px solid var(--line);
  border-radius:18px;
  padding:18px;
  box-shadow:0 10px 30px rgba(0,0,0,.20);
}

.panel h2{
  margin:0 0 12px;
  font-size:18px;
}

.inputPanel{
  position:sticky;
  top:16px;
  min-width:0;
}

label{
  display:block;
  font-size:12px;
  color:var(--muted);
  margin:10px 0 6px;
}

input,
select,
button{
  width:100%;
  max-width:100%;
  min-width:0;
  border-radius:10px;
  border:1px solid var(--line);
  background:#0b1734;
  color:var(--text);
  padding:12px;
  font-size:14px;
}

input::placeholder{
  color:var(--muted2);
}

.row2{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:10px;
  min-width:0;
}

button{
  margin-top:14px;
  background:linear-gradient(180deg,#1d5cff,#3f86ff);
  border:none;
  cursor:pointer;
  font-weight:700;
}

button:hover{
  filter:brightness(1.08);
}

button:disabled{
  opacity:.72;
  cursor:wait;
}

.savedProfiles{
  margin-top:14px;
  border:1px solid rgba(103,193,255,.16);
  border-radius:14px;
  padding:14px;
  background:
    radial-gradient(circle at 10% 0%, rgba(103,193,255,.08), transparent 34%),
    rgba(255,255,255,.025);
  min-width:0;
  max-width:100%;
}

.savedProfiles h3{
  margin:0 0 10px;
  color:var(--text);
  font-size:13px;
  font-weight:900;
  letter-spacing:.06em;
  text-transform:uppercase;
}

.savedProfiles label{
  margin-top:8px;
}

.savedProfiles button{
  margin-top:10px;
  padding:10px 12px;
  font-size:12px;
}

.savedProfiles .profileButtonRow{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:10px;
  min-width:0;
}

.savedProfiles .profileButtonRow button{
  margin-top:10px;
}

.savedProfiles .deleteProfileBtn{
  background:linear-gradient(180deg,rgba(255,102,102,.82),rgba(172,52,74,.92));
}

.profileSaveHelper{
  margin-top:9px;
  color:var(--muted2);
  font-size:11px;
  line-height:1.4;
}

.profileSaveStatus{
  min-height:17px;
  margin-top:8px;
  color:var(--blue);
  font-size:11px;
  font-weight:800;
  line-height:1.4;
}

.tiny{
  font-size:11px;
  color:var(--muted);
  margin-top:10px;
  line-height:1.45;
  overflow-wrap:break-word;
}

.leftStack{
  display:grid;
  gap:12px;
  margin-top:14px;
  min-width:0;
}

.statusBlock{
  padding:14px;
  border:1px solid var(--line);
  border-radius:14px;
  background:rgba(255,255,255,.02);
  font-size:12px;
  line-height:1.55;
  color:var(--muted);
  min-width:0;
  max-width:100%;
  overflow-wrap:anywhere;
  white-space:pre-line;
}

.statusBlock strong{
  color:var(--text);
  display:block;
  margin-bottom:6px;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.mobileTechnicalDetails{
  margin-top:14px;
  border:1px solid rgba(103,193,255,.14);
  border-radius:14px;
  background:rgba(255,255,255,.02);
  overflow:hidden;
}

.mobileTechnicalDetails summary{
  cursor:pointer;
  list-style:none;
  padding:12px 14px;
  color:var(--muted);
  font-size:12px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.mobileTechnicalDetails summary::-webkit-details-marker{
  display:none;
}

.mobileTechnicalDetails summary::after{
  content:" +";
  color:var(--muted2);
}

.mobileTechnicalDetails[open] summary::after{
  content:" -";
}

.mobileTechnicalDetails .leftStack{
  margin-top:0;
  padding:0 12px 12px;
}

.ok{
  color:var(--green);
  font-weight:700;
}

.err{
  color:#ff9c9c;
  font-weight:700;
}

.mainStack{
  display:grid;
  gap:16px;
  width:100%;
  max-width:100%;
  min-width:0;
}

.plainReadCard,
.sameFieldExplainerCard,
.personalLandingCard{
  position:relative;
  width:100%;
  max-width:100%;
  min-width:0;
  overflow:hidden;
  border-radius:22px;
  box-shadow:
    0 18px 52px rgba(0,0,0,.26),
    inset 0 0 0 1px rgba(255,255,255,.02);
}

.plainReadCard{
  border:1px solid rgba(111,224,211,.24);
  padding:20px;
  background:
    radial-gradient(circle at 10% 0%, rgba(111,224,211,.13), transparent 34%),
    radial-gradient(circle at 92% 8%, rgba(103,193,255,.075), transparent 34%),
    linear-gradient(180deg,rgba(15,27,56,.97),rgba(12,24,50,.94));
}

.plainReadCard::before,
.sameFieldExplainerCard::before,
.personalLandingCard::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(135deg,rgba(255,255,255,.035),transparent 44%),
    radial-gradient(circle at 52% 0%, rgba(103,193,255,.045), transparent 44%);
}

.plainReadCard > *,
.sameFieldExplainerCard > *,
.personalLandingCard > *{
  position:relative;
  z-index:1;
}

.plainReadHeader,
.personalLandingHeader{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:14px;
  margin-bottom:15px;
  min-width:0;
}

.plainReadHeader h2,
.personalLandingHeader h2{
  margin:0;
  font-size:22px;
  letter-spacing:-.02em;
}

.plainReadHeader p,
.personalLandingHeader p{
  margin:5px 0 0;
  color:#c4cee6;
  font-size:13px;
  line-height:1.5;
  max-width:680px;
  overflow-wrap:break-word;
}

.plainReadGrid,
.personalLandingGrid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  min-width:0;
}

.plainReadBlock,
.personalLandingBlock{
  border:1px solid rgba(255,255,255,.075);
  border-radius:16px;
  padding:14px;
  background:rgba(255,255,255,.03);
  min-height:116px;
  min-width:0;
  max-width:100%;
}

.plainReadBlock.primary{
  grid-column:1 / -1;
  min-height:150px;
  padding:18px;
  border-color:rgba(111,224,211,.25);
  background:
    radial-gradient(circle at 14% 0%, rgba(111,224,211,.14), transparent 34%),
    radial-gradient(circle at 100% 14%, rgba(103,193,255,.08), transparent 30%),
    linear-gradient(180deg,rgba(111,224,211,.075),rgba(103,193,255,.035));
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.025),
    0 12px 34px rgba(0,0,0,.18);
}

.personalLandingBlock.full{
  grid-column:1 / -1;
  border-color:rgba(216,184,76,.20);
  background:
    radial-gradient(circle at 10% 0%, rgba(216,184,76,.10), transparent 34%),
    rgba(255,255,255,.03);
}

.plainReadLabel,
.personalLandingLabel{
  color:var(--muted);
  font-size:11px;
  font-weight:900;
  letter-spacing:.10em;
  text-transform:uppercase;
  margin-bottom:7px;
}

.plainReadBlock.primary .plainReadLabel{
  color:#8bf1e6;
  font-size:11px;
  letter-spacing:.12em;
}

.personalLandingBlock.full .personalLandingLabel{
  color:var(--gold);
}

.plainReadValue,
.personalLandingValue{
  color:var(--text);
  font-size:18px;
  font-weight:900;
  line-height:1.25;
  overflow-wrap:anywhere;
}

.plainReadBlock.primary .plainReadValue{
  font-size:clamp(25px,2.7vw,34px);
  letter-spacing:-.035em;
}

.plainReadText,
.personalLandingText{
  color:var(--muted);
  margin-top:8px;
  font-size:12px;
  line-height:1.55;
  overflow-wrap:break-word;
}

.plainReadBlock.primary .plainReadText{
  color:#d9e0f4;
  margin-top:10px;
  max-width:860px;
  font-size:14px;
  line-height:1.62;
}

.sameFieldExplainerCard{
  border:1px solid rgba(216,184,76,.22);
  padding:22px;
  background:
    radial-gradient(circle at 10% 0%, rgba(216,184,76,.13), transparent 34%),
    radial-gradient(circle at 92% 12%, rgba(176,108,255,.08), transparent 34%),
    linear-gradient(180deg,rgba(15,27,56,.97),rgba(12,24,50,.94));
}

.sameFieldKicker{
  color:var(--gold);
  font-size:11px;
  font-weight:950;
  letter-spacing:.14em;
  text-transform:uppercase;
  margin-bottom:8px;
}

.sameFieldExplainerCard h2{
  margin:0;
  color:var(--text);
  font-size:clamp(24px,2.8vw,34px);
  line-height:1.08;
  letter-spacing:-.035em;
  max-width:920px;
  text-wrap:balance;
}

.sameFieldLaw{
  margin-top:12px;
  display:inline-flex;
  align-items:center;
  max-width:100%;
  min-height:34px;
  padding:8px 12px;
  border-radius:999px;
  border:1px solid rgba(103,193,255,.18);
  background:rgba(103,193,255,.075);
  color:var(--blue);
  font-size:12px;
  font-weight:950;
  letter-spacing:.04em;
  overflow-wrap:anywhere;
}

.sameFieldText{
  max-width:920px;
  margin:13px 0 0;
  color:#d9e0f4;
  font-size:14px;
  line-height:1.65;
  font-weight:720;
  overflow-wrap:break-word;
}

.personalLandingCard{
  border:1px solid rgba(216,184,76,.20);
  padding:20px;
  background:
    radial-gradient(circle at 10% 0%, rgba(216,184,76,.105), transparent 34%),
    radial-gradient(circle at 92% 8%, rgba(103,193,255,.075), transparent 34%),
    linear-gradient(180deg,rgba(15,27,56,.97),rgba(12,24,50,.94));
}

.premiumCard{
  position:relative;
  width:100%;
  max-width:100%;
  min-width:0;
  overflow:hidden;
  border:1px solid rgba(103,193,255,.28);
  border-radius:24px;
  padding:25px;
  background:
    radial-gradient(circle at 15% -8%, rgba(103,193,255,.16), transparent 39%),
    radial-gradient(circle at 88% 16%, rgba(216,184,76,.13), transparent 34%),
    radial-gradient(circle at 52% 112%, rgba(176,108,255,.07), transparent 40%),
    linear-gradient(180deg,rgba(17,33,68,.99),rgba(12,24,50,.97));
  box-shadow:
    0 24px 70px rgba(0,0,0,.34),
    inset 0 0 0 1px rgba(255,255,255,.035);
}

.premiumCard::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(135deg,rgba(255,255,255,.048),transparent 40%),
    radial-gradient(circle at 50% 110%, rgba(103,193,255,.095), transparent 44%);
}

.premiumCard::after{
  content:"";
  position:absolute;
  inset:1px;
  pointer-events:none;
  border-radius:23px;
  border:1px solid rgba(255,255,255,.025);
}

.cardContent{
  position:relative;
  z-index:1;
  min-width:0;
  max-width:100%;
}

.kicker{
  margin:0 0 9px;
  font-size:11px;
  font-weight:900;
  letter-spacing:.13em;
  text-transform:uppercase;
  color:var(--blue);
}

.weatherLine{
  margin:0;
  max-width:100%;
  font-size:clamp(30px,3.9vw,46px);
  line-height:1.01;
  font-weight:950;
  letter-spacing:-.045em;
  color:var(--text);
  text-wrap:balance;
  overflow-wrap:anywhere;
}

.weatherLine span{
  color:var(--gold);
}

.weatherExplain{
  margin:11px 0 0;
  color:#c4cee6;
  font-size:12px;
  line-height:1.45;
  font-weight:800;
  letter-spacing:.01em;
  overflow-wrap:break-word;
}

.pairingExplain{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:13px;
  max-width:940px;
  color:var(--muted);
  font-size:12px;
  line-height:1.45;
  font-weight:850;
  min-width:0;
}

.pairingExplain span{
  display:inline-flex;
  align-items:center;
  min-width:0;
  max-width:100%;
  min-height:31px;
  padding:7px 11px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.10);
  background:rgba(255,255,255,.045);
  overflow-wrap:anywhere;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.012);
}

.pairingExplain strong{
  color:var(--text);
  font-weight:950;
  white-space:nowrap;
}

.harmonicName{
  font-weight:950;
}

.h-structured{color:var(--h-structured)}
.h-contained{color:var(--h-contained)}
.h-chaotic{color:var(--h-chaotic)}
.h-relational{color:var(--h-relational)}
.h-threshold{color:var(--h-threshold)}
.h-reconstructive{color:var(--h-reconstructive)}
.h-integrative{color:var(--h-integrative)}
.h-diffused{color:var(--h-diffused)}
.h-regulated{color:var(--h-regulated)}
.h-steady{color:var(--h-steady)}

.interactionMap{
  margin-top:13px;
  width:100%;
  max-width:100%;
  min-width:0;
  border:1px solid rgba(103,193,255,.18);
  border-radius:18px;
  padding:12px;
  background:
    radial-gradient(circle at 8% 0%, rgba(103,193,255,.10), transparent 35%),
    radial-gradient(circle at 92% 0%, rgba(216,184,76,.09), transparent 34%),
    linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.018));
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.018),
    0 10px 26px rgba(0,0,0,.12);
}

.interactionMapLabel{
  color:var(--muted);
  font-size:10px;
  font-weight:950;
  letter-spacing:.12em;
  text-transform:uppercase;
  margin-bottom:10px;
}

.interactionMapGrid{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1.25fr);
  gap:10px;
  align-items:stretch;
  min-width:0;
}

.interactionNode{
  border:1px solid rgba(255,255,255,.09);
  border-radius:15px;
  padding:12px 13px;
  background:rgba(255,255,255,.035);
  min-height:96px;
  min-width:0;
  display:grid;
  align-content:start;
  gap:6px;
}

.interactionNode.move{
  border-color:rgba(216,184,76,.22);
  background:
    radial-gradient(circle at 8% 0%, rgba(216,184,76,.11), transparent 34%),
    rgba(216,184,76,.045);
}

.interactionNodeLabel{
  color:#b9c5e2;
  font-size:10px;
  font-weight:950;
  letter-spacing:.11em;
  text-transform:uppercase;
}

.interactionNodeName{
  color:var(--text);
  font-size:16px;
  font-weight:950;
  line-height:1.22;
  overflow-wrap:anywhere;
  min-width:0;
}

.interactionNodeText{
  color:#d7def1;
  font-size:12px;
  line-height:1.48;
  font-weight:700;
  overflow-wrap:break-word;
  min-width:0;
}

.interactionOperator{
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--gold);
  font-size:20px;
  font-weight:950;
  min-width:18px;
  opacity:.92;
}

.fieldCompass{
  margin-top:13px;
  width:100%;
  max-width:100%;
  min-width:0;
  border:1px solid rgba(111,224,211,.18);
  border-radius:18px;
  padding:12px;
  background:
    radial-gradient(circle at 10% 0%, rgba(111,224,211,.10), transparent 35%),
    radial-gradient(circle at 95% 0%, rgba(103,193,255,.08), transparent 34%),
    linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.018));
  box-shadow:
