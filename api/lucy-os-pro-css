  }

  .shareCardUndertoneTitle,
  .shareCardRegulationTitle{
    font-size:18px;
  }

  .shareCardCoreText{
    font-size:14px;
  }

  .shareCardRead{
    font-size:15px;
  }

  .shareCardRealLife{
    border-radius:14px;
    padding:12px;
  }

  .shareCardMoonstamp{
    border-radius:14px;
    padding:12px;
  }

  .shareActions{
    grid-template-columns:minmax(0,1fr);
  }
