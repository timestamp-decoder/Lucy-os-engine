  .shareCardPlainTitle{
    font-size:20px;
  }

  .shareCardPlainText{
    font-size:13px;
  }

  .shareCardFieldTitle{
    font-size:20px;
  }

  .shareCardFieldText,
  .shareCardUndertoneText,
  .shareCardRegulationText{
