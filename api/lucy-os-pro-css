  .outlookBlock.primary .outlookValue{
    font-size:25px;
  }

  .regulationSupportBlock.primary .regulationSupportText,
  .outlookBlock.primary .outlookText{
    font-size:13px;
  }

  .regulationSupportList{
    font-size:12.5px;
  }

  .moonstampModifierBlock{
    border-radius:14px;
    padding:12px;
  }

  .profileBlock{
    min-height:auto;
  }

  .profileValue{
