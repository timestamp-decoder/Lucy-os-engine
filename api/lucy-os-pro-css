  .liveDashboardText{
    display:none;
  }

  .liveDashboardMeter{
    height:7px;
    margin-top:8px;
  }

  .liveDashboardBand{
    align-self:start;
    min-height:19px;
    margin-top:8px;
    padding:3px 7px;
    font-size:8.5px;
    line-height:1.12;
  }

  .liveDashboardNote{
    margin-top:11px;
    padding-top:10px;
    font-size:10.2px;
    line-height:1.4;
  }

  .profileHeader,
  .regulationSupportHeader,
  .outlookHeader{
    display:grid;
  }

  .regulationSupportCard,
  .outlookCard{
    padding:18px;
  }

  .regulationSupportHeader h2,
  .outlookHeader h2{
    font-size:24px;
  }

